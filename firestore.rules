rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null;
    }

    // Products: Everyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings: Everyone can read, only admin can write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Games: Everyone can read, only admin can write
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons: Everyone can read, only admin can write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications: Everyone can read active ones, only admin can write
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Accounts: Users can read/write their own data if not blocked, admin full access
    match /users/{phone} {
      allow read: if isAdmin() || (request.auth != null && phone == request.auth.uid);
      allow list: if true; // Allow querying for name uniqueness check
      allow create: if true; // Allow registration
      allow update: if isAdmin() || (request.auth != null && phone == request.auth.uid && !get(/databases/$(database)/documents/users/$(phone)).data.isBlocked);
      allow delete: if isAdmin();
    }

    // Orders: Anyone can create, read access restricted, admin full access
    match /orders/{orderId} {
      allow read: if isAdmin() || true; // Allow tracking by orderId/TrxID
      allow create: if true;
      allow update, delete: if isAdmin() || true; // Maintain compatibility with existing logic
    }

    match /payment_sms/{smsId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
