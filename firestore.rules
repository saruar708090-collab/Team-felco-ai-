rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if user is authenticated and registered in the admins collection
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // PRODUCTS: Public read (viewing products). Only authenticated admins can write/edit.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SETTINGS: Public read (payment/support configurations). Only authenticated admins can write/edit.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ORDERS: Public read & create. Auto-update to COMPLETED (if matching payment_sms exists) or CANCELLED (if auto-rejected).
    match /orders/{orderId} {
      allow read, create: if true;
      allow update: if isAdmin() || (
        resource.data.orderStatus == 'PENDING' && (
          (request.resource.data.orderStatus == 'COMPLETED' && exists(/databases/$(database)/documents/payment_sms/$(resource.data.paymentTrxId))) ||
          request.resource.data.orderStatus == 'CANCELLED'
        )
      );
      allow delete: if isAdmin();
    }

    // PAYMENT_SMS: Individual get allowed by exact TrxID for verification; list only for admins.
    match /payment_sms/{trxId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || request.resource.data.webhookKey == 'FELCO2026';
      allow update: if isAdmin() || (resource.data.used == false && request.resource.data.used == true);
      allow delete: if isAdmin();
    }

    // ADMINS: Admins can manage admins. Authenticated users can write/edit their own admin document during authentication.
    match /admins/{adminId} {
      allow read, write: if request.auth != null && request.auth.uid == adminId;
      allow read, write: if isAdmin();
    }

    // COUPONS: Public read for validation. Only authenticated admins can write/edit.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
