{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store products like Colour Trading Tool and Aviator Tool",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "price": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase orders",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 50 },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "selectedGame": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "telegramId": { "type": "string", "maxLength": 100 },
        "whatsappNumber": { "type": "string", "maxLength": 50 },
        "paymentMethod": { "type": "string" },
        "paymentTrxId": { "type": "string", "maxLength": 100 },
        "paymentScreenshotUrl": { "type": "string", "maxLength": 1000 },
        "orderStatus": { "type": "string", "enum": ["PENDING", "PROCESSING", "COMPLETED", "CANCELLED"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderId", "productId", "productName", "selectedGame", "customerName", "telegramId", "whatsappNumber", "paymentMethod", "paymentTrxId", "orderStatus"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Store settings, payment info, and customer service details",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "supportWhatsApp": { "type": "string" },
        "supportTelegram": { "type": "string" },
        "supportText": { "type": "string" },
        "businessHours": { "type": "string" },
        "bkashNumber": { "type": "string" },
        "bkashActive": { "type": "boolean" },
        "nagadNumber": { "type": "string" },
        "nagadActive": { "type": "boolean" },
        "rocketNumber": { "type": "string" },
        "rocketActive": { "type": "boolean" },
        "paymentInstructions": { "type": "string" },
        "scrollingNotice": { "type": "string", "maxLength": 500 }
      }
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized admin users",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["email"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon codes",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 50 },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "discountValue": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "discountType", "discountValue", "active"]
    },
    "PaymentSms": {
      "title": "PaymentSms",
      "description": "Incoming bKash, Nagad, and Rocket transaction SMS records for automatic order verification",
      "type": "object",
      "properties": {
        "trxId": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "sender": { "type": "string" },
        "rawSms": { "type": "string", "maxLength": 1000 },
        "used": { "type": "boolean" },
        "usedByOrderId": { "type": "string" },
        "webhookKey": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["trxId", "amount", "used"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Store products collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders collection"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Global store settings"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin authorization collection"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Discount coupon codes"
    },
    "/payment_sms/{trxId}": {
      "schema": { "$ref": "#/entities/PaymentSms" },
      "description": "Verified incoming payment SMS records for auto-verification"
    }
  }
}
